          },
          "radius_m": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "判定の半径（m）。1〜10,000"
          },
          "user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "利用者。省くと既定の利用者（FR-29。単一利用者でも列は day one から持つ）"
          }
        },
        "additionalProperties": false
      },
      "RebuildResponse": {
        "type": "object",
        "description": "`POST /stays/rebuild` の応答。**値（座標・時刻）を含まない。**",
