{
  "openapi": "3.1.0",
  "info": {
    "title": "ashiato S-01",
    "description": "書き込みは 1 本の取り込み口に集約する。読みは PostgREST が別に自動生成する。",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/attributes": {
      "get": {
        "tags": [],
        "summary": "種類ごとのいまの値・予定・積んだ主張・取り消された主張を返す（design D8）。",
        "description": "**先頭で住所と職業を置く**（design D7（仮））—— 種類を 1 つも持たない利用者が\n最初に見る画面が空にならないため。反転条件は design D7。",
        "operationId": "attributes_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttributesView"
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        }
      }
    },
    "/attributes/kinds": {
      "post": {
        "tags": [],
        "summary": "種類を足す（design D7）。空・いまある名前と重なるものは 400。",
        "operationId": "attributes_kind_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KindRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KindCreated"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KindError"
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        }
      }
    },
    "/attributes/kinds/{id}/names": {
      "post": {
        "tags": [],
        "summary": "種類の名前を変える（design D7）。**前の名前は台帳に残る**（追記のみ）。",
        "operationId": "attributes_kind_name_post",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "種類の識別子",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KindRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KindError"
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        }
      }
    },
    "/coverage": {
      "get": {
        "tags": [],
        "summary": "ソース × 日 の 8 状態を返す（FR-54）。**状態は行に焼かず導出する**（design D6）。",
        "operationId": "coverage_get",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "description": "利用者。**省略すると絞らない**（単一利用者でも列は day one から持つ。FR-29 / 扉 #9）",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SourceCoverage"
                  }
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        }
      }
    },
    "/coverage/achievement": {
      "get": {
        "tags": [],
        "summary": "5 ソースの達成日数と分母、合否、確定か暫定か（NFR-13）。",
        "operationId": "achievement_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Achievement"
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        }
      }
    },
    "/events": {
      "get": {
        "tags": [],
        "summary": "削除されていない記録を時刻順に返す（FR-50 のビュー越し）。",
        "operationId": "events",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventRow"
                  }
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        }
      }
    },
    "/heartbeat": {
      "post": {
        "tags": [],
        "summary": "生存信号をまとめて受け取る（FR-78）。",
        "description": "**`/ingest` と統合しない**（design D9）—— `/ingest` は記録のエンベロープ\n（`event_time` / `tz_id` / `schema_version` / `crs` …）を必須にしており、\n生存信号はそのどれも持たない。混ぜると片方のために必須の欄が緩む。\n\n400 は「1 件も受け付けなかった」ことを意味する（`/ingest` と同じ約束）。",
        "operationId": "heartbeat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HeartbeatRequest"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HeartbeatResult"
                  }
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HeartbeatResult"
                  }
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        }
      }
    },
    "/ingest": {
      "post": {
        "tags": [],
        "summary": "記録をまとめて受け取る。同じ内容を再送しても行は増えない（FR-22）。",
        "description": "要求は**配列**（まとめ送り。design D9）。1 件だけの裸のオブジェクトも受け取る ——\n既存の収集側と `tools/smoke.sh` を壊さないため（design D12）。\n応答は**送った順に並ぶ 1 件ごとの結果**で、収集側は `accepted` が真の分だけを\n未送信から取り除く。\n\n**400 は「1 件も受け付けなかった」ことを意味する。** 一部だけが不正なときは 200 を返し、\n正しい分は格納される —— 1 件の恒久的な失敗が後続を永久に止めないため。",
        "operationId": "ingest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/IngestRequest"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IngestResult"
                  }
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IngestResult"
                  }
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        }
      }
    },
    "/stays": {
      "get": {
        "tags": [],
        "summary": "1 日の並び（滞在・移動・記録なし）を時刻順に返す（design D8）。",
        "operationId": "stays_get",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "description": "`YYYY-MM-DD`（Asia/Tokyo の日）",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayView"
                }
              }
            }
          },
          "400": {
            "description": ""
          },
          "401": {
            "description": ""
          }
        }
      }
    },
    "/stays/criteria": {
      "get": {
        "tags": [],
        "summary": "利用者の判定の基準の版を古い順に返す（spec「判定の基準は利用者ごとに版として残る」）。",
        "operationId": "stays_criteria_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CriteriaVersion"
                  }
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        }
      }
    },
    "/stays/rebuild": {
      "post": {
        "tags": [],
        "summary": "全期間の滞在を作り直す（FR-31 / Q6 / C10）。基準が添えられ、いまと違えば新しい版を足してから作り直す。",
        "description": "**範囲外の基準は 400 で、基準も滞在も変えない**（DB の `CHECK` に当てると 500 になる）。",
        "operationId": "stays_rebuild",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RebuildRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RebuildResponse"
                }
              }
            }
          },
          "400": {
            "description": ""
          },
          "401": {
            "description": ""
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Achievement": {
        "type": "object",
        "description": "5 ソースの達成と、成功条件 1 の合否（NFR-13）。",
        "required": [
          "sources",
          "verdict",
          "failing",
          "confirmed",
          "not_started"
        ],
        "properties": {
          "confirmed": {
            "type": "boolean",
            "description": "**5 本すべての窓が閉じた日にのみ確定**（第 7 回 Q27）"
          },
          "confirms_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "確定する日。**1 本でも開始していなければ返らない**"
          },
          "days_until_confirmed": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "確定までの残り日数。同上"
          },
          "failing": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "落ちたソース。どれが落ちたかがそのまま分かる"
          },
          "not_started": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "まだ収集を開始していないソース。確定日が定まらない理由"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceAchievement"
            }
          },
          "verdict": {
            "type": "boolean",
            "description": "**5 本すべてが分母の 95 % 以上**か（第 4 回 Q9 / 第 5 回 Q18）"
          }
        }
      },
      "AttributesView": {
        "type": "object",
        "description": "個人属性の読み出し全体（design D8）。",
        "required": [
          "today",
          "kinds"
        ],
        "properties": {
          "kinds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KindView"
            }
          },
          "today": {
            "type": "string",
            "description": "`Asia/Tokyo` の今日"
          }
        }
      },
      "Band": {
        "type": "string",
        "description": "格子の 3 段。**8 状態の区別は週を選んだときの文字が担う**（第 5 回 Q20 / Q21）。",
        "enum": [
          "recorded",
          "alive_no_record",
          "other"
        ]
      },
      "ClaimOut": {
        "type": "object",
        "description": "読み出しが返す 1 件（design D8）。",
        "required": [
          "id",
          "valid_from",
          "asserted_at",
          "ingested_at"
        ],
        "properties": {
          "asserted_at": {
            "type": "string",
            "description": "RFC 3339（地域のずれつき）"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ingested_at": {
            "type": "string",
            "description": "RFC 3339"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "superseded_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "どの主張に取り消されたか（取り消された主張にだけ入る）"
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "valid_from": {
            "$ref": "#/components/schemas/ValidFrom"
          },
          "value": {
            "type": [
              "string",
              "null"
            ],
            "description": "`null` が「なし」"
          }
        }
      },
      "CriteriaTag": {
        "type": "object",
        "description": "並んだ滞在を作った基準（一覧の上に出す）。",
        "required": [
          "criteria_id",
          "radius_m",
          "min_minutes"
        ],
        "properties": {
          "criteria_id": {
            "type": "integer",
            "format": "int64"
          },
          "min_minutes": {
            "type": "integer",
            "format": "int32"
          },
          "radius_m": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CriteriaVersion": {
        "type": "object",
        "description": "基準の版 1 つ（`GET /stays/criteria` の 1 行）。",
        "required": [
          "id",
          "radius_m",
          "min_minutes",
          "gap_minutes",
          "sources",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "gap_minutes": {
            "type": "integer",
            "format": "int32"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "min_minutes": {
            "type": "integer",
            "format": "int32"
          },
          "radius_m": {
            "type": "integer",
            "format": "int32"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DayCell": {
        "type": "object",
        "description": "1 日ぶんの状態と、その日の材料。",
        "required": [
          "day",
          "state",
          "event_count",
          "blockers",
          "intervals"
        ],
        "properties": {
          "attempts": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "その日の生存信号が報告した取得の試行回数の合計。**信号が無い日は返らない**\n—— 来ていない区間の取得率は埋まらない（specs）"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "その日に報告された、満たされていないもの（FR-78 / specs「何が満たされていないかが返る」）。\n**取れる状態しか無い日は空**"
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "event_count": {
            "type": "integer",
            "format": "int32"
          },
          "intervals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Interval"
            },
            "description": "**区間ごと**の取得率（第 5 回 Q17）。日に畳んだ合計だけだと\n「眠っていた区間」が薄まる —— 想定間隔 6 時間なら 1 日 4 区間になる（review/code.md の R9）"
          },
          "state": {
            "$ref": "#/components/schemas/DayState"
          },
          "successes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "DayEntry": {
        "type": "object",
        "description": "並びの 1 行。**滞在は実際の始まりと終わり**（日をまたいでも切らない）、移動と記録なしはその日の中に切る。",
        "required": [
          "kind",
          "start",
          "end"
        ],
        "properties": {
          "criteria_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "滞在を作った基準の版（滞在の行だけ。取り込みの口から入った滞在には無いことがある）"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "滞在の識別子（滞在の行だけ）"
          },
          "kind": {
            "$ref": "#/components/schemas/EntryKind"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DayState": {
        "type": "string",
        "description": "ソース × 日 の状態（FR-54）。**8 つのいずれか 1 つに決まる。**\n\n⑧「退役」は ST03 の深掘りが差し戻したもの（R55 / R56）—— ソースを分けて\n古い名前を退役させる運用が通常になったため、**退役した後の空白日**を\n⑥「途絶」と区別できないと、退役したソースが毎日「壊れている」ように見える。",
        "enum": [
          "recorded",
          "alive_no_record",
          "alive_not_capturable",
          "stopped",
          "dropped",
          "outage",
          "before_start",
          "retired"
        ]
      },
      "DayView": {
        "type": "object",
        "description": "`GET /stays` の応答。",
        "required": [
          "date",
          "criteria",
          "entries"
        ],
        "properties": {
          "criteria": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CriteriaTag"
            },
            "description": "その日に並んだ滞在を作った基準。**新しい版から順に**、重複なし（design D8。先頭が一覧の上の基準）"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DayEntry"
            },
            "description": "始まりの時刻順"
          }
        }
      },
      "EntryKind": {
        "type": "string",
        "description": "並びの 1 行の種類。",
        "enum": [
          "stay",
          "move",
          "no-record"
        ]
      },
      "EventRow": {
        "type": "object",
        "required": [
          "id",
          "logical_source",
          "event_time",
          "tz_id",
          "origin",
          "raw"
        ],
        "properties": {
          "event_time": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "logical_source": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "raw": {
            "type": "string",
            "description": "原文は**文字列**（design D16）。JSON 型で持つと DB が並びと表記を正規化する"
          },
          "tz_id": {
            "type": "string"
          }
        }
      },
      "HeartbeatError": {
        "type": "string",
        "description": "生存信号を断った理由。**受け取った値は載せない**（`IngestError` と同じ向き）。",
        "enum": [
          "malformed",
          "unknown_source",
          "invalid_raw",
          "missing_blockers",
          "invalid_counts"
        ]
      },
      "HeartbeatRequest": {
        "type": "object",
        "description": "収集側が送る 1 件。**`/ingest` と混ぜない**（design D9）——\n記録のエンベロープ（`tz_id` / `schema_version` / `crs` …）を生存信号は 1 つも持たない。",
        "required": [
          "id",
          "user_id",
          "logical_source",
          "emitted_at",
          "capturable",
          "attempts",
          "successes",
          "raw"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "format": "int32",
            "description": "前回の生存信号からの取得の試行回数（第 5 回 Q17）"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "取得できないとき、何が満たされていないか。`capturable = false` なら空にできない"
          },
          "capturable": {
            "type": "boolean",
            "description": "そのソースを取得できる状態か（権限・センサ・接続。深掘り Q5）"
          },
          "device_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "emitted_at": {
            "type": "string",
            "format": "date-time",
            "description": "収集側が信号を作った時刻。**受信時刻ではない** ——\n圏外で溜めて送ると受信は数日後になる（第 6 回 Q24 と同じ理由）。"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "logical_source": {
            "type": "string"
          },
          "raw": {
            "type": "string",
            "description": "収集側から受け取った原文。**素通しで残す**（0003 と同じ理由で `text`）"
          },
          "successes": {
            "type": "integer",
            "format": "int32",
            "description": "そのうち成功した回数（同上）"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "HeartbeatResult": {
        "type": "object",
        "description": "送った 1 件ごとの結果。**送った順に並ぶ**（`IngestResult` と同じ約束）。",
        "required": [
          "duplicate",
          "accepted"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "未送信から取り除いてよいか。収集側はこれだけを見る"
          },
          "duplicate": {
            "type": "boolean",
            "description": "既に同じ 1 件があったか。再送しても行が増えないことの確認に使う"
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HeartbeatError"
              }
            ]
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "IngestError": {
        "type": "string",
        "description": "取り込みを断った理由。**受け取った値は載せない**（design D5）——\n値をそのまま返すと、呼び出し元へ内容が反射する。",
        "enum": [
          "malformed",
          "unknown_origin",
          "unknown_source",
          "invalid_raw",
          "missing_device_id",
          "missing_external_id",
          "empty_external_id",
          "id_reused"
        ]
      },
      "IngestRequest": {
        "type": "object",
        "required": [
          "id",
          "user_id",
          "logical_source",
          "origin",
          "event_time",
          "tz_offset_min",
          "tz_id",
          "schema_version",
          "raw",
          "payload"
        ],
        "properties": {
          "crs": {
            "type": [
              "string",
              "null"
            ],
            "description": "座標系。省略時は `EPSG:4326`（FR-28 / design D4）"
          },
          "device_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_time": {
            "type": "string",
            "format": "date-time"
          },
          "external_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "external_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "「対象ごと」の外部識別子（動画 ID など。ST03 / 深掘り Q24）。\n**重複の判定には使わない** —— 使うと同じ対象の 2 件目が一意違反で落ちる。"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "logical_source": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "payload": {},
          "raw": {
            "type": "string",
            "description": "取得元から受け取った原文。**文字列で持つ**（深掘り 第 2 回 / design D16）——\nJSON 型に入れると DB がキー順・重複キー・数値表記を正規化し、\n「バイト単位で一致する」が成り立たなくなる。"
          },
          "schema_version": {
            "type": "integer",
            "format": "int32"
          },
          "source_updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "外部サービス側の更新時刻（または版）。省略できる（ST03 / 深掘り Q20）——\n**既存の収集側を壊さない**。届かない到着は「届いた順」で適用され、\n保存済みの値を消さない。"
          },
          "tz_id": {
            "type": "string"
          },
          "tz_offset_min": {
            "type": "integer",
            "format": "int32"
          },
          "unit_system": {
            "type": [
              "string",
              "null"
            ],
            "description": "単位系。省略時は `si`（FR-28 / design D4）"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "IngestResult": {
        "type": "object",
        "description": "送った 1 件ごとの結果。**送った順に並ぶ**ので、収集側は位置で対応づける\n（design D12）。断られた項目には `id` が無い場合がある。",
        "required": [
          "duplicate",
          "accepted"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "未送信から取り除いてよいか。収集側はこれだけを見る（design D9）"
          },
          "duplicate": {
            "type": "boolean",
            "description": "既に同じ 1 件があったか。再送しても行が増えないことの確認に使う（FR-22）"
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/IngestError",
                "description": "断った理由の種別。受け付けたときは null"
              }
            ]
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "格納された記録の識別子。断られたときは null"
          }
        }
      },
      "Interval": {
        "type": "object",
        "description": "生存信号 1 件ぶんの区間。**これが「前回の信号から今回まで」にあたる。**",
        "required": [
          "emitted_at",
          "capturable",
          "attempts",
          "successes"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "format": "int32"
          },
          "capturable": {
            "type": "boolean"
          },
          "emitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "successes": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "KindCreated": {
        "type": "object",
        "description": "種類を足した結果。",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "KindError": {
        "type": "string",
        "description": "種類の操作を断る理由（design D7）。どれも 400。",
        "enum": [
          "empty_name",
          "duplicate_name",
          "unknown_kind"
        ]
      },
      "KindRequest": {
        "type": "object",
        "description": "種類を足す・名前を変える要求の本文。",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "省けば nil UUID（ほかの読み出しと同じ。ST29 まで利用者は名乗り）"
          }
        }
      },
      "KindView": {
        "type": "object",
        "description": "種類 1 つぶんの読み出し（design D8）。",
        "required": [
          "id",
          "name",
          "upcoming",
          "claims",
          "superseded"
        ],
        "properties": {
          "claims": {
            "type": "array",
