{
  "openapi": "3.1.0",
  "info": {
    "title": "ashiato S-01",
    "description": "書き込みは 1 本の取り込み口に集約する。読みは PostgREST が別に自動生成する。",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/events": {
      "get": {
        "tags": [],
        "summary": "削除されていない記録を時刻順に返す（FR-50 のビュー越し）。",
        "operationId": "events",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventRow"
                  }
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        }
      }
    },
    "/ingest": {
      "post": {
        "tags": [],
        "summary": "記録をまとめて受け取る。同じ内容を再送しても行は増えない（FR-22）。",
        "description": "要求は**配列**（まとめ送り。design D9）。1 件だけの裸のオブジェクトも受け取る ——\n既存の収集側と `tools/smoke.sh` を壊さないため（design D12）。\n応答は**送った順に並ぶ 1 件ごとの結果**で、収集側は `accepted` が真の分だけを\n未送信から取り除く。\n\n**400 は「1 件も受け付けなかった」ことを意味する。** 一部だけが不正なときは 200 を返し、\n正しい分は格納される —— 1 件の恒久的な失敗が後続を永久に止めないため。",
        "operationId": "ingest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/IngestRequest"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IngestResult"
                  }
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IngestResult"
                  }
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventRow": {
        "type": "object",
        "required": [
          "id",
          "logical_source",
          "event_time",
          "tz_id",
          "origin",
          "raw"
        ],
        "properties": {
          "event_time": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "logical_source": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "raw": {
            "type": "string",
            "description": "原文は**文字列**（design D16）。JSON 型で持つと DB が並びと表記を正規化する"
          },
          "tz_id": {
            "type": "string"
          }
        }
      },
      "IngestError": {
        "type": "string",
        "description": "取り込みを断った理由。**受け取った値は載せない**（design D5）——\n値をそのまま返すと、呼び出し元へ内容が反射する。",
        "enum": [
          "malformed",
          "unknown_origin",
          "unknown_source",
          "invalid_raw",
          "missing_device_id"
        ]
      },
      "IngestRequest": {
        "type": "object",
        "required": [
          "id",
          "user_id",
          "logical_source",
          "origin",
          "event_time",
          "tz_offset_min",
          "tz_id",
          "schema_version",
          "raw",
          "payload"
        ],
        "properties": {
          "crs": {
            "type": [
              "string",
              "null"
            ],
            "description": "座標系。省略時は `EPSG:4326`（FR-28 / design D4）"
          },
          "device_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_time": {
            "type": "string",
            "format": "date-time"
          },
          "external_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "logical_source": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "payload": {},
          "raw": {
            "type": "string",
            "description": "取得元から受け取った原文。**文字列で持つ**（深掘り 第 2 回 / design D16）——\nJSON 型に入れると DB がキー順・重複キー・数値表記を正規化し、\n「バイト単位で一致する」が成り立たなくなる。"
          },
          "schema_version": {
            "type": "integer",
            "format": "int32"
          },
          "tz_id": {
            "type": "string"
          },
          "tz_offset_min": {
            "type": "integer",
            "format": "int32"
          },
          "unit_system": {
            "type": [
              "string",
              "null"
            ],
            "description": "単位系。省略時は `si`（FR-28 / design D4）"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "IngestResult": {
        "type": "object",
        "description": "送った 1 件ごとの結果。**送った順に並ぶ**ので、収集側は位置で対応づける\n（design D12）。断られた項目には `id` が無い場合がある。",
        "required": [
          "duplicate",
          "accepted"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "未送信から取り除いてよいか。収集側はこれだけを見る（design D9）"
          },
          "duplicate": {
            "type": "boolean",
            "description": "既に同じ 1 件があったか。再送しても行が増えないことの確認に使う（FR-22）"
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/IngestError",
                "description": "断った理由の種別。受け付けたときは null"
              }
            ]
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "格納された記録の識別子。断られたときは null"
          }
        }
      }
    }
  }
}
