              }
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "superseded": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClaimOut"
            },
            "description": "訂正で取り消された主張"
          },
          "upcoming": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClaimOut"
            },
            "description": "「いつから」が今日より後（予定）。古い順"
          }
        }
      },
      "Precision": {
        "type": "string",
        "description": "「いつから」の精度（深掘り C3）。**丸めない** ——\n2019 年とだけ分かっている値を 2019-01-01 にすると、丸めたことが後から分からない。",
        "enum": [
          "year",
          "month",
          "day",
          "unknown"
        ]
      },
      "RebuildRequest": {
        "type": "object",
        "description": "`POST /stays/rebuild` の本文。**すべて省ける**（省いた基準はいまの値のまま）。",
        "properties": {
          "gap_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
