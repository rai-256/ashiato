          },
          "stays_before": {
            "type": "integer",
            "format": "int64",
            "description": "作り直す前に読み出しに出ていた滞在の件数"
          },
          "took_ms": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "SourceAchievement": {
        "type": "object",
        "description": "ソース 1 本ぶんの達成（NFR-13）。",
        "required": [
          "logical_source",
