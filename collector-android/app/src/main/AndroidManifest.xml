<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- FR-1 位置。背景での取得は収集の前提（成功条件 1） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- FR-10 自宅 PC へ送る -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 生存信号が「接続できる状態か」を読むのに要る（ST02 / FR-78 / 深掘り Q5）。
         **無いと ConnectivityManager.getNetworkCapabilities が SecurityException を投げ**、
         起動時の生存信号がそれを貫通して落ち、START_STICKY と合わさってクラッシュループになる
         （review/code.md の R31。実機でしか出ない型の失敗）。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 継続的な位置取得は前景サービスなしに許されない。常時通知は本人が受け入れ済み（design D7） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 位置の権限が無い間の前景サービスの種別（ST06 / design D5 のリスク / tasks 5.1）。
         targetSdk 34 以降、位置の権限を持たないまま foregroundServiceType="location" で
         startForeground を呼ぶと SecurityException で立てられず、**2 本目のソース
         （アプリ利用）まで道連れに止まる**。位置が取れない間だけ specialUse に落ちる。
         **dataSync ではない** —— Android 15 以降、dataSync の前景サービスは 24 時間のうち
         6 時間で打ち切られるので、位置を拒んだままの端末（＝アプリ利用だけを取る端末）は
         毎日 18 時間収集が止まる。specialUse にその上限は無い。
         打ち切られたときの備えは LocationService.onTimeout（畳んで落ちない）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ST17: 再起動の後に通知の予約を戻す（実行時の確認の要らない権限）。
         **正確な時刻の権限（SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM）は宣言しない** —— 15 分の窓で足りる（design D10） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- FR-2 アプリ利用。**特別なアクセス**（設定アプリで本人が許す）なので、
         宣言しただけでは付かない —— 宣言が無いと設定画面の一覧にすら出ない -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- D2: 利用イベントに現れた任意のアプリの表示名を取得する。
         LAUNCHER の queries だけでは起動入口のない第三者アプリを覆えない。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- FR-3 写真の位置。宣言しないと OS が EXIF の位置を落として返す（EXT-D） -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- ST09 Q6/Q5: 動画の一覧（メタだけ）を読む。Task 2 の計測テスト（P12: 動画の入れ物の位置）が先に要る。
         要求の流れは MainActivity（位置の後に写真と動画と写真の位置をまとめて求める。design D6） -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14 以降の「選んだ写真だけ」。宣言が無いとこの選び方が出ず、全部か何もかの二択になる -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- minSdk 30 の端末（32 以下）は READ_MEDIA_* が無く、この 1 本が写真と動画の読み取りを兼ねる -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- FR-11 健康データ（ST11 / design D5）。履歴の権限は**後から与えても全履歴が読める**（premises P2・P13）。
         初回起動で求めるのは、履歴の権限が無い端末で読める範囲の起点（アプリごと）を早めるため。
         宣言していない権限は求めても権限の画面に出ないので、6 つとも宣言する -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Health Connect のアプリを引く（Android 13 以前は別の apk、14 以降は OS の一部） -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- 平文 HTTP は**設定した接続先 1 ホストだけ**に許す（生成物 / build.gradle.kts）。
         これが無いと targetSdk 28 以降は遮断され、送信が黙って失敗し続ける -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="あしあと。"
        android:dataExtractionRules="@xml/health_data_extraction_rules"
        android:fullBackupContent="@xml/health_full_backup_content"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <!-- 権限を求めて収集を始めるだけの入口。画面は V-01（web）が持つ -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ST11 design D7: 健康データの権限の画面の「プライバシーポリシー」の行き先。文だけの画面 -->
        <activity
            android:name=".HealthRationaleActivity"
            android:exported="true">
            <!-- Android 13 以前の Health Connect が使う開き方 -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Android 14 以降が使う開き方 -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".HealthRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".LocationService"
            android:exported="false"
            android:foregroundServiceType="location|specialUse">
            <!-- specialUse の種別には用途の宣言が要る（宣言が無いと startForeground が立たない）。
                 この収集は「本人の端末の行動履歴を絶やさず記録し続ける」ためのもので、
                 位置が取れない間も 1 年間途切れずに続くこと（成功条件 1）が要件そのものにある。 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous personal life-log collection (FR-1 / FR-2)" />
        </service>

        <!-- ST17 design D10: 毎日の気分の通知。収集の経路（LocationService）とは別の受け手 -->
        <receiver
            android:name=".FeelingReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".FeelingReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
