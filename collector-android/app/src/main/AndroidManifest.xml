<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- FR-1 位置。背景での取得は収集の前提（成功条件 1） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- FR-10 自宅 PC へ送る -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 生存信号が「接続できる状態か」を読むのに要る（ST02 / FR-78 / 深掘り Q5）。
         **無いと ConnectivityManager.getNetworkCapabilities が SecurityException を投げ**、
         起動時の生存信号がそれを貫通して落ち、START_STICKY と合わさってクラッシュループになる
         （review/code.md の R31。実機でしか出ない型の失敗）。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 継続的な位置取得は前景サービスなしに許されない。常時通知は本人が受け入れ済み（design D7） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 位置の権限が無い間の前景サービスの種別（ST06 / design D5 のリスク）。
         targetSdk 34 以降、位置の権限を持たないまま foregroundServiceType="location" で
         startForeground を呼ぶと SecurityException で立てられず、**2 本目のソース
         （アプリ利用）まで道連れに止まる**。位置が取れない間だけ dataSync に落ちる。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- FR-2 アプリ利用。**特別なアクセス**（設定アプリで本人が許す）なので、
         宣言しただけでは付かない —— 宣言が無いと設定画面の一覧にすら出ない -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- FR-3 写真の位置。宣言しないと OS が EXIF の位置を落として返す（EXT-D） -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- FR-11 健康データの履歴。**宣言しない期間の 30 日より前は永久に読めない**（EXT-C） -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!-- 平文 HTTP は**設定した接続先 1 ホストだけ**に許す（生成物 / build.gradle.kts）。
         これが無いと targetSdk 28 以降は遮断され、送信が黙って失敗し続ける -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="あしあと。"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <!-- 権限を求めて収集を始めるだけの入口。画面は V-01（web）が持つ -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".LocationService"
            android:exported="false"
            android:foregroundServiceType="location|dataSync" />
    </application>
</manifest>
