<!-- design D14（仮）: 健康データの印と最後の状態だけを、クラウドのバックアップと端末の移行から外す。
     ほかの置き場（collector など）は既定のまま。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="health_permission.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="health_permission.xml" />
    </device-transfer>
</data-extraction-rules>
