# 雛形だけコミットする。実値は .env に置き、コミットしない（製造準備 A-2）。
# **change-me で始まる値のまま tools/db-roles.sh は役割を作らない**（ST28 / design D4）。
# 乱数で作る: `openssl rand -hex 24`

# DB の合言葉は 3 つ。管理者（役割を作る）・所有者（移行を当てる）・アプリ（サーバの実行時）。
# 管理者と所有者の合言葉はサーバの環境に渡さない。
POSTGRES_PASSWORD=change-me-admin-db-password
OWNER_DB_PASSWORD=change-me-owner-db-password
APP_DB_PASSWORD=change-me-app-db-password
# URL の合言葉は上の値と同じにする。サーバが使うのはアプリの役割（DATABASE_URL）だけ。
# 所有者の URL は移行と試験の足場（cargo test）が使う。
DATABASE_URL=postgres://ashiato_app:change-me-app-db-password@127.0.0.1:55432/ashiato
DATABASE_OWNER_URL=postgres://ashiato_owner:change-me-owner-db-password@127.0.0.1:55432/ashiato
BIND=127.0.0.1:18787
# 16 文字以上。ローカルでも必須（同じ PC の別プロセスを素通しさせない）
API_TOKEN=change-me-0123456789abcdef
# 画面のログインの合言葉。16 文字以上で、change-me で始まる値のままではサーバが起動しない
WEB_PASSWORD=change-me-web-password
# 利用者は 1 名（PERM-1 / design D8）。収集側もこの値を送る。
# Android へは ~/.gradle/gradle.properties の ashiato.userId で渡す
ASHIATO_USER_ID=00000000-0000-0000-0000-000000000000

# 画面を手元の網（Tailscale など）越しに開くときに許すホスト。先頭 . でサブドメイン全体。
# **本物の網の名前はここに書かない**（このファイルは公開される）。`.env` にだけ書く。
ALLOWED_HOSTS=.example.ts.net
