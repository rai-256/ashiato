# 雛形だけコミットする。実値は .env に置き、コミットしない（製造準備 A-2）。
DATABASE_URL=postgres://ashiato:ashiato@127.0.0.1:55432/ashiato
BIND=127.0.0.1:18787
# 16 文字以上。ローカルでも必須（同じ PC の別プロセスを素通しさせない）
API_TOKEN=change-me-0123456789abcdef
# 利用者は 1 名（PERM-1 / design D8）。収集側もこの値を送る。
# Android へは ~/.gradle/gradle.properties の ashiato.userId で渡す
ASHIATO_USER_ID=00000000-0000-0000-0000-000000000000

# 画面を手元の網（Tailscale など）越しに開くときに許すホスト。先頭 . でサブドメイン全体。
# **本物の網の名前はここに書かない**（このファイルは公開される）。`.env` にだけ書く。
ALLOWED_HOSTS=.example.ts.net
